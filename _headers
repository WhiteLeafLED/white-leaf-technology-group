/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self'; frame-src https://challenges.cloudflare.com; connect-src 'self' https://forms.whiteleafled.net https://challenges.cloudflare.com https://cloudflareinsights.com; form-action 'self' https://forms.whiteleafled.net; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

/media/*
  Cache-Control: public, max-age=2592000

/img/*
  Cache-Control: public, max-age=2592000

/fonts/*
  Cache-Control: public, max-age=2592000
